[Unit]
Description=GetVideo HTTP API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/project/GetVideo
EnvironmentFile=/home/ubuntu/project/GetVideo/.env
ExecStart=/home/ubuntu/project/GetVideo/.venv/bin/uvicorn getvideo.api:app --host 127.0.0.1 --port 8900
Restart=on-failure
RestartSec=10
UMask=0077

[Install]
WantedBy=multi-user.target
