# 复制为 .env 后按需修改；.env 不进 Git。
# 可选：方舟 API Key 只放在服务端，不要写进 Android APK。
ARK_API_KEY=
# 按顺序尝试；当前默认先 mini，失败时再试 pro。实际可调用范围以账号开通状态为准。
GETVIDEO_ARK_MODELS=doubao-seed-2-0-mini-260428,doubao-seed-2-1-pro-260915
# 可选的本地 Ollama 后备；都不可用时使用规则分类。
GETVIDEO_OLLAMA_URL=http://127.0.0.1:11434
GETVIDEO_OLLAMA_MODEL=
GETVIDEO_CLASSIFY_TIMEOUT=60
# 正式使用请生成独立 AES-256 密钥；不填写时使用 data/.secret_key 的本地开发密钥。
# GETVIDEO_SECRET_KEY=<32 字节的 URL-safe base64>

# 抖音开放平台：已审核的网站应用；密钥仅服务端配置，不提交 Git。
GETVIDEO_DOUYIN_CLIENT_KEY=
GETVIDEO_DOUYIN_CLIENT_SECRET=
# 与开放平台登记一致，HTTPS，路径 /account/platform-auth/douyin/callback
GETVIDEO_DOUYIN_REDIRECT_URI=
